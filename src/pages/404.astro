---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import { Image } from "astro:assets";
import nonaPig from "../assets/images/ilustraciones/nona-pig.webp";
import logoMorcilla from "../assets/images/logos/logo-morcilla-01.webp";
import "../styles/global.css";

/**
 * Pagina de error propia.
 *
 * Antes, una URL inexistente mostraba la pagina generica de Hostinger, en ingles
 * y sin marca: el visitante no tenia por donde seguir y se iba. Aca se le ofrece
 * volver a la landing, a productos o escribir directo por WhatsApp.
 *
 * Astro la genera como dist/404.html, y el servidor la sirve por la regla
 * ErrorDocument de public/.htaccess. Sin esa regla, Hostinger sigue mostrando
 * la suya. Va con noindex y queda fuera del sitemap.
 *
 * Sin navbar ni pie, a proposito: con el menu y el pie del sitio parecia una
 * seccion mas y no un error. Solo el logo, que lleva al inicio.
 *
 * Los enlaces van con barra delante (/#productos): desde /404 el ancla suelta
 * no llevaria a ningun lado.
 */

const atajos = [
  { label: "Productos", href: "/#productos" },
  { label: "Nosotros", href: "/#nosotros" },
  { label: "Preguntas frecuentes", href: "/#preguntas" },
  { label: "Pedir presupuesto", href: "/#contacto" },
];
---

<Layout
  title="Página no encontrada | Porco Rosso Mayorista"
  description="La página que buscás no existe. Porco Rosso, proveedor mayorista de carne de cerdo en CABA y GBA."
  noindex
>
  <header class="absolute top-0 left-0 w-full z-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 md:h-20 flex items-center">
      <a href="/" aria-label="Porco Rosso, ir al inicio">
        <Image
          src={logoMorcilla}
          alt="Porco Rosso - Proveedor mayorista de carne porcina"
          class="h-10 md:h-12 w-auto"
          widths={[110, 220]}
          sizes="110px"
          loading="eager"
        />
      </a>
    </div>
  </header>
  <main id="contenido-principal" class="relative overflow-hidden bg-hueso min-h-dvh flex items-center">
    <!-- El 404 es el protagonista: gigante y semitransparente, detras del texto.
         Es decorativo; el codigo lo anuncia el titulo de la pagina. En celular
         de fondo quedaba flotando detras de los botones, asi que ahi va arriba,
         en el flujo, con la ilustracion apoyada encima (ver mas abajo).
         Todo se dimensiona tambien por el alto de la pantalla (dvh) para que la
         pagina entre justa, sin scroll, en celulares bajos y en notebooks. -->
    <div
      aria-hidden="true"
      class="pointer-events-none select-none absolute inset-0 hidden md:flex items-center justify-center"
    >
      <span class="font-display font-bold leading-none tracking-tight text-carne/15 text-[min(38vw,72dvh)]">
        404
      </span>
    </div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 md:pt-20 pb-6 md:pb-10 w-full">
      <div class="grid md:grid-cols-[1fr_auto] gap-16 items-center">

        <div>
          <!-- Version celular del 404: el numero a la izquierda y la abuela
               colgada cabeza abajo de un hilo que baja desde arriba de todo de la
               pantalla. Va en posicion absoluta para que colgar no empuje el
               contenido (la pagina tiene que entrar sin scroll) y el hilo se
               corta en el borde de arriba porque el main tiene overflow-hidden.
               Superpuesta al numero no funcionaba: su relleno blanco tapaba los
               digitos. Todo se dimensiona por el alto (dvh) ademas del ancho. -->
          <div aria-hidden="true" class="md:hidden select-none relative mb-5">
            <span id="numero-404" class="block w-fit font-display font-bold leading-[0.7] tracking-tight text-carne/20 text-[min(46vw,23dvh)]">
              404
            </span>
            <span id="abuela-colgada" class="colgada absolute right-0 -top-[26%]">
              <span class="absolute bottom-full left-1/2 -translate-x-1/2 translate-y-1 w-px h-[100dvh] bg-morcilla/30"></span>
              <Image
                src={nonaPig}
                alt=""
                class="block h-[calc(min(46vw,23dvh)*0.98)] w-auto max-w-none rotate-180"
                widths={[110, 220]}
                sizes="110px"
                loading="eager"
              />
            </span>
          </div>

          <span class="font-accent text-xs tracking-widest text-carne uppercase">Página no encontrada</span>
          <h1 class="font-display font-bold uppercase text-[min(3rem,6.5dvh)] md:text-7xl leading-[0.9] text-morcilla mt-2 md:mt-3 mb-3 md:mb-5">
            Este corte<br /><span class="text-carne">no lo tenemos.</span>
          </h1>
          <p class="text-sm md:text-base text-morcilla/60 max-w-md">
            La página que buscás no existe o cambió de dirección. Lo que sí tenemos
            es carne de cerdo de producción propia para tu negocio: seguí por acá.
          </p>

          <div class="mt-5 md:mt-8 flex flex-col sm:flex-row gap-2 sm:gap-3">
            <Button href="/" size="md">Volver al inicio</Button>
            <a
              href="https://wa.me/5491172714251?text=Hola%20Porco%20Rosso!%20Quiero%20info%20mayorista"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 border-2 border-carne text-carne font-display font-semibold uppercase text-sm tracking-wider hover:bg-carne hover:text-hueso transition-colors"
            >
              Escribinos por WhatsApp
            </a>
          </div>

          <nav aria-label="Secciones del sitio" class="mt-6 pt-4 md:mt-12 md:pt-6 border-t border-morcilla/10 max-w-md [@media(max-height:700px)]:hidden">
            <h2 class="font-display text-xs uppercase tracking-wider text-morcilla/40 mb-2 md:mb-3">
              O andá directo a
            </h2>
            <ul class="grid grid-cols-2 gap-x-6 gap-y-1.5 md:gap-y-2">
              {atajos.map((a) => (
                <li>
                  <a href={a.href} class="whitespace-nowrap text-morcilla hover:text-carne transition-colors text-sm">
                    {a.label} <span aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>

        <div class="hidden md:flex justify-center">
          <Image
            src={nonaPig}
            alt="Ilustración Nona Pig - Porco Rosso"
            class="h-[min(24rem,50dvh)] w-auto opacity-90"
            widths={[228, 456]}
            sizes="228px"
            loading="eager"
          />
        </div>

      </div>
    </div>
  </main>
</Layout>

<style>
  /* La abuela oscila desde donde esta atado el hilo, arriba de la pantalla,
     no desde sus pies: por eso el eje esta 100dvh por encima. El movimiento
     lo maneja el script de abajo. */
  .colgada {
    transform-origin: 50% -100dvh;
    will-change: transform;
  }

  /* Cuando la abuela choca contra el ultimo 4, el numero se enciende de
     golpe y vuelve a su semitransparencia, con un temblor corto. */
  .golpe {
    animation: golpe 0.7s ease-out;
  }
  @keyframes golpe {
    0% { color: color-mix(in srgb, var(--color-carne) 75%, transparent); transform: translateX(-4px); }
    15% { transform: translateX(3px); }
    30% { transform: translateX(-2px); }
    45% { transform: translateX(0); }
    100% { color: color-mix(in srgb, var(--color-carne) 20%, transparent); }
  }
</style>

<script>
  // Pendulo de la abuela colgada (solo celular).
  //
  // Es una simulacion y no una animacion CSS porque la gracia esta en que no
  // sea regular: en cada pasada por el centro se sortea una fuerza nueva, y
  // segun cuanta le toque llega o no a tocar el ultimo 4. Si lo toca, rebota
  // y el 404 se enciende (clase .golpe). El choque se detecta midiendo las
  // cajas en pantalla, asi funciona igual en cualquier ancho.
  //
  // Angulo positivo = hacia la izquierda, hacia el numero: con el eje arriba,
  // rotar en sentido horario lleva los pies hacia la izquierda.

  const abuela = document.getElementById("abuela-colgada");
  const numero = document.getElementById("numero-404");
  const sinMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (abuela && numero && !sinMovimiento) {
    const PERIODO = 3.4; // segundos por vaiven completo
    const w = (2 * Math.PI) / PERIODO;

    // Cuantos grados tiene que abrirse el pendulo para tocar el 4. Depende
    // del ancho y del alto de la pantalla, asi que se mide en vez de fijarlo:
    // se toma la distancia libre con la abuela quieta y se pasa a angulo con
    // el radio del pendulo (el eje esta 100dvh arriba de sus pies, y la parte
    // que choca es la falda, que cabeza abajo queda cerca de los pies).
    let anguloTope = 1.5;
    const medirTope = () => {
      const previo = abuela.style.transform;
      abuela.style.transform = "none";
      const a = abuela.getBoundingClientRect();
      const n = numero.getBoundingClientRect();
      abuela.style.transform = previo;
      const libre = a.left + a.width * 0.14 - n.right;
      const radio = window.innerHeight + a.height * 0.15;
      if (libre > 0 && radio > 0) anguloTope = (Math.atan(libre / radio) * 180) / Math.PI;
    };
    // Cada ida se sortea entre la mitad y 1,4 veces lo necesario para llegar:
    // mas o menos la mitad de las veces lo toca y la otra mitad se queda corta.
    const sortear = () => Math.max(0.5, anguloTope * (0.5 + Math.random() * 0.9));
    medirTope();
    window.addEventListener("resize", medirTope);

    let angulo = 0;
    let velocidad = w * sortear();
    let anterior = performance.now();
    let ultimoGolpe = 0;

    const chocaConElNumero = () => {
      const a = abuela.getBoundingClientRect();
      const n = numero.getBoundingClientRect();
      // La imagen tiene margen vacio a los costados del dibujo.
      return a.left + a.width * 0.14 <= n.right;
    };

    const paso = (ahora: number) => {
      // Mas de 50 ms entre cuadros es una pestaña que volvio de segundo plano:
      // no se integra ese salto.
      const dt = Math.min((ahora - anterior) / 1000, 0.05);
      anterior = ahora;

      // Solo corre si la version celular esta visible.
      if (abuela.offsetParent !== null) {
        const antes = angulo;
        velocidad += -w * w * angulo * dt;
        angulo += velocidad * dt;

        // Al cruzar el centro se sortea la fuerza de la proxima ida.
        if ((antes < 0) !== (angulo < 0)) {
          velocidad = Math.sign(velocidad) * w * sortear();
        }

        if (velocidad > 0 && chocaConElNumero()) {
          velocidad = -velocidad * 0.55; // rebote que pierde fuerza
          if (ahora - ultimoGolpe > 400) {
            ultimoGolpe = ahora;
            numero.classList.remove("golpe");
            void numero.offsetWidth; // reinicia la animacion si ya estaba
            numero.classList.add("golpe");
          }
        }

        abuela.style.transform = `rotate(${angulo}deg)`;
      }
      requestAnimationFrame(paso);
    };

    numero.addEventListener("animationend", () => numero.classList.remove("golpe"));
    requestAnimationFrame(paso);
  }
</script>
