---
interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
}

const {
  title = "Porco Rosso | Proveedor de Carne Porcina y Vacuna en Buenos Aires",
  description = "Proveedor mayorista de carne de cerdo y vacuna para restaurantes, hoteles y gastronomía en Buenos Aires. Producción propia, cadena completa, trazabilidad total. Pedí tu presupuesto.",
  canonicalURL = Astro.url.href,
} = Astro.props;

const ogImage = new URL("/images/og/og-image.png", Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Porco Rosso - Proveedor mayorista de carne porcina y vacuna en Buenos Aires" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Porco Rosso" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Geo targeting -->
    <meta name="geo.region" content="AR-B" />
    <meta name="geo.placename" content="Buenos Aires" />

    <!-- Robots -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Fuentes: Montserrat (body) + Barlow Condensed (display, stand-in Acme Gothic) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=Montserrat:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <!-- reCAPTCHA v3 -->
    <script src="https://www.google.com/recaptcha/api.js?render=RECAPTCHA_SITE_KEY_HERE" async defer></script>

    <!-- Structured Data: LocalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Porco Rosso",
      "description": "Empresa familiar agroindustrial. Proveedor mayorista de carne porcina y vacuna en Buenos Aires. Criamos, faenamos, despostamos, elaboramos y vendemos.",
      "url": canonicalURL,
      "logo": ogImage,
      "image": ogImage,
      "telephone": "+5491140453345",
      "email": "hola@porcorosso.com.ar",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Martín Fierro 3361, Complejo Thays Local 17",
        "addressLocality": "Ituzaingó",
        "addressRegion": "Buenos Aires",
        "addressCountry": "AR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -34.6587,
        "longitude": -58.6679
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
        "opens": "10:00",
        "closes": "18:00"
      },
      "priceRange": "$$",
      "areaServed": {
        "@type": "GeoCircle",
        "geoMidpoint": { "@type": "GeoCoordinates", "latitude": -34.6037, "longitude": -58.3816 },
        "geoRadius": "100000"
      },
      "knowsAbout": ["carne porcina", "carne vacuna", "cerdo", "proveedor mayorista", "gastronomía"]
    })} />
  </head>
  <body>
    <a href="#contenido-principal" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] focus:bg-carne focus:text-hueso focus:px-4 focus:py-2 focus:font-display focus:font-semibold focus:uppercase focus:text-sm">
      Ir al contenido principal
    </a>
    <slot />
    <script is:inline src="/firma-stian/firma-stian.js" defer></script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
