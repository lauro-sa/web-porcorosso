---
import { Image } from "astro:assets";
import Button from "./Button.astro";
import papaPig02 from "../assets/images/ilustraciones/papa-pig-02.webp";
---

<section class="relative min-h-dvh flex items-center bg-hueso overflow-hidden">
  <!-- Background illustration -->
  <div class="absolute right-0 bottom-0 w-1/2 opacity-10 pointer-events-none hidden lg:block">
    <Image src={papaPig02} alt="Ilustración Papa Pig - Porco Rosso" class="w-full h-auto" widths={[400, 600]} sizes="(max-width: 1024px) 0px, 50vw" loading="lazy" />
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-16 relative z-10">
    <div class="max-w-3xl">
      <!-- Tag -->
      <span class="font-accent text-sm tracking-widest text-carne mb-6 block">
        PRODUCTOR DIRECTO &middot; 1.600 MADRES PORCINAS &middot; ENTREGAS EN CABA Y GBA
      </span>

      <!-- Titulo -->
      <h1 class="font-display font-bold uppercase text-5xl sm:text-6xl md:text-7xl lg:text-8xl leading-[0.9] text-morcilla mb-6">
        CRIAMOS,<br />
        <span class="text-carne">PRODUCIMOS</span><br />
        Y ENTREGAMOS.
      </h1>

      <!-- Descripcion -->
      <p class="text-lg md:text-xl text-morcilla/70 max-w-xl mb-10 leading-relaxed">
        Somos una empresa familiar agroindustrial que se hace cargo de toda la cadena: criamos, faenamos, despostamos, elaboramos, movemos y vendemos nuestros productos. Sin intermediarios, con trazabilidad completa.
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-4">
        <Button href="#contacto" variant="primary" size="lg">
          Quiero ser cliente
        </Button>
        <Button
          href="https://wa.me/5491172714251?text=Hola%20Porco%20Rosso!%20Quiero%20info%20mayorista"
          variant="outline"
          size="lg"
          target="_blank"
          rel="noopener noreferrer"
        >
          WhatsApp mayorista
        </Button>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-50">
    <span class="font-accent text-xs tracking-widest text-morcilla/50">DESLIZÁ</span>
    <div class="w-px h-8 bg-morcilla/30 animate-pulse"></div>
  </div>
</section>
