---
interface Props {
  tag?: string;
  title: string;
  accent?: string;
  description?: string;
  align?: "left" | "center";
  dark?: boolean;
}

const {
  tag,
  title,
  accent,
  description,
  align = "left",
  dark = false,
} = Astro.props;

const alignClass = align === "center" ? "text-center" : "text-left";
const tagColor = dark ? "text-piel" : "text-carne";
const titleColor = dark ? "text-hueso" : "text-morcilla";
const descColor = dark ? "text-hueso/70" : "text-morcilla/60";
---

<div class={`${alignClass} mb-10 md:mb-14`}>
  {tag && (
    <span class={`font-accent text-sm tracking-widest uppercase ${tagColor} mb-3 block`}>
      {tag}
    </span>
  )}
  <h2 class={`font-display font-bold uppercase text-3xl md:text-4xl lg:text-5xl leading-tight ${titleColor}`}>
    {title}
    {accent && <span class={dark ? "text-piel" : "text-carne"}> {accent}</span>}
  </h2>
  {description && (
    <p class={`mt-4 text-base md:text-lg max-w-2xl leading-relaxed ${descColor} ${align === "center" ? "mx-auto" : ""}`}>
      {description}
    </p>
  )}
</div>
