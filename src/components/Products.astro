---
import SectionTitle from "./SectionTitle.astro";
import Tag from "./Tag.astro";

const products = [
  {
    name: "Piezas enteras",
    tag: "Producción propia",
    description: "Cortes enteros de cerdo con trazabilidad completa. Ideales para desposte propio, elaboración o venta directa en mostrador.",
    items: ["Bondiola", "Matambrito", "Costillitas", "Pork Belly", "Solomillo", "Vacío", "Ribs de carré", "Carré"],
    image: "/images/productos/bondiola.webp",
    width: 1200,
    height: 941,
    highlighted: true,
  },
  {
    name: "Fraccionadas al vacío",
    tag: "Listas para tu operación",
    description: "Cortes fraccionados y envasados al vacío. Listos para recibir, almacenar y usar. Estandarizados para que tu negocio no dependa del azar.",
    items: ["Bondiola porcionada", "Costillitas rack", "Pork Belly laminado", "Matambrito porcionado", "Cortes a medida"],
    image: "/images/productos/tapa-de-asado.webp",
    width: 1200,
    height: 945,
    highlighted: false,
  },
  {
    name: "Productos elaborados",
    tag: "Elaboración propia",
    description: "Listos para freidora, plancha o parrilla. Elaborados con recetas propias y la misma materia prima de nuestro criadero.",
    items: ["Milanesas de cerdo", "Milanesas de pollo", "Chorizo bombón", "Morcilla dulce", "Morcilla salada", "Salchicha parrillera"],
    image: "/images/productos/chorizo-bombon.webp",
    width: 1200,
    height: 1591,
    highlighted: false,
  },
];
---

<section id="productos" class="py-20 md:py-28 bg-hueso">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionTitle
      tag="Productos mayoristas"
      title="Lo que mejor"
      accent="sabemos hacer."
      description="Producción propia con trazabilidad completa. Cortes consistentes para que tu negocio nunca dependa del azar."
    />

    <div class="grid gap-6 md:gap-8">
      {products.map((product, i) => (
        <div
          class={`grid md:grid-cols-2 gap-0 overflow-hidden ${
            product.highlighted ? "border-2 border-carne" : "border border-morcilla/10"
          }`}
        >
          <!-- Image -->
          <div class={`aspect-[4/3] md:aspect-auto overflow-hidden ${i % 2 === 1 ? "md:order-2" : ""}`}>
            <img
              src={product.image}
              alt={`${product.name} - Cortes de carne Porco Rosso Buenos Aires`}
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
              width={product.width}
              height={product.height}
              loading="lazy"
            />
          </div>

          <!-- Content -->
          <div class={`p-8 md:p-12 flex flex-col justify-center ${
            product.highlighted ? "bg-carne text-hueso" : "bg-frigo"
          }`}>
            <Tag variant={product.highlighted ? "hueso" : "carne"}>
              {product.tag}
            </Tag>
            <h3 class={`font-display font-bold text-2xl md:text-3xl uppercase mt-4 mb-3 ${
              product.highlighted ? "text-hueso" : "text-morcilla"
            }`}>
              {product.name}
            </h3>
            <p class={`mb-6 leading-relaxed ${
              product.highlighted ? "text-hueso/80" : "text-morcilla/60"
            }`}>
              {product.description}
            </p>
            <div class="flex flex-wrap gap-2 mb-6">
              {product.items.map((item) => (
                <span class={`text-xs font-display uppercase tracking-wider px-3 py-1.5 ${
                  product.highlighted
                    ? "bg-hueso/15 text-hueso"
                    : "bg-morcilla/5 text-morcilla/70"
                }`}>
                  {item}
                </span>
              ))}
            </div>
            <a
              href="#contacto"
              class={`inline-flex items-center gap-2 font-display font-semibold text-sm uppercase tracking-wider transition-colors ${
                product.highlighted
                  ? "text-hueso hover:text-hueso/70"
                  : "text-carne hover:text-carne-dark"
              }`}
            >
              Pedí presupuesto &rarr;
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
