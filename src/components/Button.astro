---
interface Props {
  variant?: "primary" | "outline" | "ghost";
  size?: "sm" | "md" | "lg";
  href?: string;
  class?: string;
  [key: string]: any;
}

const {
  variant = "primary",
  size = "md",
  href,
  class: className = "",
  ...rest
} = Astro.props;

const Tag = href ? "a" : "button";

const baseClasses = "inline-flex items-center justify-center font-display font-semibold uppercase tracking-wider transition-all duration-300 cursor-pointer";

const variantClasses = {
  primary: "bg-carne text-hueso hover:bg-carne-dark",
  outline: "border-2 border-carne text-carne hover:bg-carne hover:text-hueso",
  ghost: "text-morcilla hover:text-carne",
};

const sizeClasses = {
  sm: "px-4 py-2 text-xs",
  md: "px-6 py-3 text-sm",
  lg: "px-8 py-4 text-base",
};

const classes = `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${className}`;
---

<Tag href={href} class={classes} {...rest}>
  <slot />
</Tag>
