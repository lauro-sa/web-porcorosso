---
import { Image } from "astro:assets";
import SectionTitle from "./SectionTitle.astro";
import Card from "./Card.astro";
import papaPig01 from "../assets/images/ilustraciones/papa-pig-01.webp";

const pillars = [
  {
    icon: "01",
    title: "Crianza",
    text: "1.600 madres en criadero propio. Controlamos genética, bienestar animal y condiciones sanitarias desde el origen.",
  },
  {
    icon: "02",
    title: "Desposte",
    text: "Procesamos con precisión técnica, garantizando cortes uniformes y de calidad constante. Sin improvisación.",
  },
  {
    icon: "03",
    title: "Entrega",
    text: "Logística propia con cadena de frío ininterrumpida. Entregas claras y pedidos automatizados.",
  },
  {
    icon: "04",
    title: "Trazabilidad",
    text: "Cada producto es rastreable desde el campo hasta tu cocina. 100% cadena propia.",
  },
];
---

<section id="nosotros" class="py-20 md:py-28 bg-frigo">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionTitle
      tag="Nosotros"
      title="Cadena completa,"
      accent="control total."
      align="center"
      description="Somos una empresa familiar agroindustrial. Criamos, faenamos, despostamos, elaboramos y entregamos. Sin intermediarios, con trazabilidad de campo a mostrador."
    />

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-12">
      {pillars.map((pillar) => (
        <Card variant="hueso" class="group hover:shadow-lg transition-shadow duration-300">
          <span class="font-display font-bold text-4xl text-carne/20 group-hover:text-carne/40 transition-colors">
            {pillar.icon}
          </span>
          <h3 class="font-display font-bold text-xl uppercase text-morcilla mt-3 mb-2">
            {pillar.title}
          </h3>
          <p class="text-sm text-morcilla/60 leading-relaxed">
            {pillar.text}
          </p>
        </Card>
      ))}
    </div>

    <!-- Illustration -->
    <div class="mt-12 flex justify-center opacity-60">
      <Image
        src={papaPig01}
        alt="Ilustración Papa Pig - Familia productora Porco Rosso"
        class="h-32 w-auto"
        widths={[128, 256]}
        sizes="128px"
        loading="lazy"
      />
    </div>
  </div>
</section>
