---
import { Image } from "astro:assets";
import logoMorcilla from "../assets/images/logos/logo-morcilla-01.webp";

const navLinks = [
  { label: "Nosotros", href: "#nosotros" },
  { label: "Productos", href: "#productos" },
  { label: "Ventajas", href: "#ventajas" },
  { label: "Contacto", href: "#contacto" },
];
---

<nav id="navbar" class="fixed top-0 left-0 w-full z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div id="nav-inner" class="flex items-center justify-between h-20 transition-all duration-300">
      <!-- Logo -->
      <a href="/" class="flex-shrink-0">
        <Image
          id="nav-logo"
          src={logoMorcilla}
          alt="Porco Rosso - Proveedor mayorista de carne porcina"
          class="nav-logo h-12 w-auto"
          widths={[110, 220]}
          sizes="110px"
          loading="eager"
        />
      </a>

      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center gap-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="font-display font-semibold text-sm uppercase tracking-wider text-morcilla hover:text-carne transition-colors duration-200"
          >
            {link.label}
          </a>
        ))}
        <a
          href="#contacto"
          data-open-form
          class="ml-2 px-5 py-2.5 bg-carne text-hueso font-display font-semibold text-sm uppercase tracking-wider hover:bg-carne-dark transition-colors duration-200 cursor-pointer"
        >
          Solicitar Info
        </a>
      </div>

      <!-- Mobile Menu Button (hamburger ↔ X) -->
      <button
        id="menu-toggle"
        class="md:hidden relative z-[70] flex justify-center items-center w-10 h-10"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="burger-line burger-top"></span>
        <span class="burger-line burger-mid"></span>
        <span class="burger-line burger-bot"></span>
      </button>
    </div>
  </div>

</nav>

<!-- Mobile Menu Overlay (fuera del nav para evitar conflictos de stacking context) -->
<div
  id="mobile-menu"
  class="fixed inset-0 bg-hueso z-[60] flex flex-col items-center justify-center gap-8 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
>
  {navLinks.map((link, i) => (
    <a
      href={link.href}
      class="mobile-link menu-item font-display font-bold text-2xl uppercase tracking-wider text-morcilla hover:text-carne transition-colors"
      style={`--delay: ${i * 80}ms`}
    >
      {link.label}
    </a>
  ))}
  <a
    href="#contacto"
    data-open-form
    class="menu-item mt-4 px-8 py-3 bg-carne text-hueso font-display font-semibold text-lg uppercase tracking-wider cursor-pointer"
    style={`--delay: ${navLinks.length * 80}ms`}
  >
    Solicitar Info
  </a>

</div>

<script>
  const navbar = document.getElementById("navbar");
  const menuToggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const mobileLinks = mobileMenu?.querySelectorAll(".mobile-link");
  const menuItems = mobileMenu?.querySelectorAll(".menu-item");
  let menuOpen = false;

  const navLogo = document.getElementById("nav-logo");
  const navInner = document.getElementById("nav-inner");

  // ---- Barra de estado de iOS ----
  // Safari pinta la barra de estado (hora, wifi, bateria) con el theme-color,
  // no con lo que se ve debajo. Como el navbar es fixed y translucido, Safari no
  // lo "ve": la barra quedaba del color del body y se cortaba contra el navbar.
  // Asi que calculamos a mano el color que el navbar muestra de verdad -frigo al
  // 80% sobre el fondo que tenga detras- y se lo pasamos a Safari.
  // El blur no se puede replicar: la barra de estado es del navegador, no nuestra.
  const themeMeta = document.querySelector('meta[name="theme-color"]');
  const NAV_RGB = [244, 242, 242]; // --color-frigo
  const NAV_ALPHA = 0.8;           // bg-frigo/80
  let navAlpha = 0;                // 0 arriba de todo, NAV_ALPHA al scrollear
  let alphaAnim = 0;
  let ultimoColor = "";
  let themeTick = false;

  /** Primer fondo opaco justo debajo de la barra de estado, salteando el navbar. */
  function fondoDetrasDelNav() {
    const capas = document.elementsFromPoint(Math.floor(window.innerWidth / 2), 1);
    for (const capa of capas) {
      if (navbar?.contains(capa)) continue;
      const rgba = getComputedStyle(capa).backgroundColor.match(/[\d.]+/g);
      if (rgba && (rgba.length < 4 || Number(rgba[3]) === 1)) {
        return [Number(rgba[0]), Number(rgba[1]), Number(rgba[2])];
      }
    }
    return NAV_RGB;
  }

  function pintarThemeColor() {
    if (!themeMeta) return;
    const fondo = fondoDetrasDelNav();
    const hex = fondo
      .map((c, i) => Math.round(NAV_RGB[i] * navAlpha + c * (1 - navAlpha)))
      .map((c) => c.toString(16).padStart(2, "0"))
      .join("");
    if (hex === ultimoColor) return;
    ultimoColor = hex;
    themeMeta.setAttribute("content", "#" + hex);
  }

  /** Acompaña los 300ms de transicion del navbar en vez de saltar de golpe. */
  function animarNavAlpha(destino: number) {
    cancelAnimationFrame(alphaAnim);
    const desde = navAlpha;
    const inicio = performance.now();
    const paso = (ahora: number) => {
      const t = Math.min((ahora - inicio) / 300, 1);
      navAlpha = desde + (destino - desde) * t;
      pintarThemeColor();
      if (t < 1) alphaAnim = requestAnimationFrame(paso);
    };
    alphaAnim = requestAnimationFrame(paso);
  }

  // Scroll effect
  let scrolledPrev: boolean | null = null;

  function aplicarScroll(animar = true) {
    if (!navbar) return;
    const scrolled = window.scrollY > 50;
    navbar.classList.toggle("bg-frigo/80", scrolled);
    navbar.classList.toggle("backdrop-blur-xl", scrolled);
    navbar.classList.toggle("shadow-sm", scrolled);
    navLogo?.classList.toggle("scrolled", scrolled);
    navInner?.classList.toggle("h-20", !scrolled);
    navInner?.classList.toggle("h-14", scrolled);

    if (scrolled === scrolledPrev) return;
    const primeraVez = scrolledPrev === null;
    scrolledPrev = scrolled;
    const destino = scrolled ? NAV_ALPHA : 0;
    // Al cargar (o si el navegador restaura el scroll) no hay nada que animar.
    if (animar && !primeraVez) {
      animarNavAlpha(destino);
    } else {
      navAlpha = destino;
      pintarThemeColor();
    }
  }

  window.addEventListener("scroll", () => {
    aplicarScroll();
    // El fondo detras del navbar cambia al pasar de seccion, pero medirlo en cada
    // evento de scroll es caro: lo hacemos una vez por frame.
    if (themeTick) return;
    themeTick = true;
    requestAnimationFrame(() => {
      themeTick = false;
      pintarThemeColor();
    });
  });

  aplicarScroll(false);

  function toggleMenu() {
    menuOpen = !menuOpen;
    if (menuOpen) {
      mobileMenu?.classList.remove("opacity-0", "pointer-events-none");
      mobileMenu?.classList.add("opacity-100", "pointer-events-auto");
      menuToggle?.classList.add("is-active");
      menuToggle?.setAttribute("aria-expanded", "true");
      menuToggle?.setAttribute("aria-label", "Cerrar menú");
      navbar?.classList.add("z-[70]");
      document.body.style.overflow = "hidden";
      requestAnimationFrame(() => menuItems?.forEach((item) => item.classList.add("visible")));
      const waFloat = document.getElementById("wa-float");
      if (waFloat) {
        waFloat.style.zIndex = "70";
        waFloat.style.bottom = "24px";
        waFloat.style.animation = "none";
        waFloat.style.opacity = "0";
        waFloat.style.transform = "scale(0) rotate(-90deg)";
        requestAnimationFrame(() => {
          waFloat.style.transition = "opacity 0.4s cubic-bezier(0.175,0.885,0.32,1.275) 0.5s, transform 0.5s cubic-bezier(0.175,0.885,0.32,1.275) 0.5s";
          waFloat.style.opacity = "1";
          waFloat.style.transform = "scale(1) rotate(0deg)";
        });
      }
    } else {
      menuItems?.forEach((item) => item.classList.remove("visible"));
      const waFloat = document.getElementById("wa-float");
      if (waFloat) {
        waFloat.style.transition = "opacity 0.2s ease, transform 0.2s ease";
        waFloat.style.opacity = "0";
        waFloat.style.transform = "scale(0)";
        setTimeout(() => {
          waFloat.style.zIndex = "";
          waFloat.style.transition = "";
          waFloat.style.animation = "";
          waFloat.style.opacity = "";
          waFloat.style.transform = "";
        }, 300);
      }
      mobileMenu?.classList.add("opacity-0", "pointer-events-none");
      mobileMenu?.classList.remove("opacity-100", "pointer-events-auto");
      menuToggle?.classList.remove("is-active");
      menuToggle?.setAttribute("aria-expanded", "false");
      menuToggle?.setAttribute("aria-label", "Abrir menú de navegación");
      navbar?.classList.remove("z-[70]");
      document.body.style.overflow = "";
    }
  }

  menuToggle?.addEventListener("click", () => {
    toggleMenu();
    // El overlay del menu tapa la pantalla entera: recalculamos cuando termina
    // su fade de 300ms, para que la barra de estado siga al color que quede.
    setTimeout(pintarThemeColor, 300);
  });
  mobileLinks?.forEach((link) => link.addEventListener("click", () => {
    if (menuOpen) toggleMenu();
  }));
</script>

<style>
  /* Logo scroll effect */
  .nav-logo {
    transition:
      transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      filter 0.4s ease;
    transform-origin: left center;
  }

  .nav-logo.scrolled {
    transform: scale(0.8);
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.1));
  }

  /* Hamburger lines */
  .burger-line {
    position: absolute;
    width: 24px;
    height: 2px;
    background-color: var(--color-morcilla);
    transition:
      transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.25s ease,
      width 0.3s ease;
  }

  .burger-top { transform: translateY(-7px); }
  .burger-mid { transform: translateY(0); }
  .burger-bot { width: 16px; transform: translateX(4px) translateY(7px); }

  /* Active → X */
  .is-active .burger-top {
    transform: rotate(45deg) translateY(0);
  }

  .is-active .burger-mid {
    opacity: 0;
    transform: scaleX(0);
  }

  .is-active .burger-bot {
    width: 24px;
    transform: rotate(-45deg) translateX(0) translateY(0);
  }

  /* Menu items stagger */
  .menu-item {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) var(--delay),
      transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) var(--delay);
  }

  .menu-item.visible {
    opacity: 1;
    transform: translateY(0);
  }

</style>
