---
const currentYear = new Date().getFullYear();
---

<footer class="bg-morcilla py-12 md:py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-3 gap-10 md:gap-8 items-start">
      <!-- Logo & tagline -->
      <div>
        <img
          src="/images/logos/logo-hueso-01.png"
          alt="Porco Rosso"
          class="h-14 w-auto mb-4"
        />
        <p class="text-hueso/40 text-sm leading-relaxed max-w-xs">
          Empresa familiar agroindustrial.<br />
          Criamos, producimos y disfrutamos.
        </p>
      </div>

      <!-- Links -->
      <div class="grid grid-cols-2 gap-8">
        <div>
          <h4 class="font-display font-bold text-xs uppercase tracking-wider text-hueso/60 mb-4">
            Secciones
          </h4>
          <ul class="space-y-2">
            <li><a href="#nosotros" class="text-sm text-hueso/40 hover:text-hueso transition-colors">Nosotros</a></li>
            <li><a href="#productos" class="text-sm text-hueso/40 hover:text-hueso transition-colors">Productos</a></li>
            <li><a href="#ventajas" class="text-sm text-hueso/40 hover:text-hueso transition-colors">Ventajas</a></li>
            <li><a href="#contacto" class="text-sm text-hueso/40 hover:text-hueso transition-colors">Contacto</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-display font-bold text-xs uppercase tracking-wider text-hueso/60 mb-4">
            Contacto
          </h4>
          <ul class="space-y-2">
            <li><a href="tel:+5491140453345" class="text-sm text-hueso/40 hover:text-hueso transition-colors">+54 9 11-4045-3345</a></li>
            <li><a href="mailto:hola@porcorosso.com.ar" class="text-sm text-hueso/40 hover:text-hueso transition-colors">hola@porcorosso.com.ar</a></li>
            <li><a href="https://porcorosso.com.ar" target="_blank" rel="noopener" class="text-sm text-hueso/40 hover:text-hueso transition-colors">porcorosso.com.ar</a></li>
          </ul>
        </div>
      </div>

      <!-- Almacen -->
      <div>
        <h4 class="font-display font-bold text-xs uppercase tracking-wider text-hueso/60 mb-4">
          Almacen
        </h4>
        <p class="text-sm text-hueso/40 leading-relaxed">
          Martin Fierro 3361, Ituzaingo<br />
          Complejo Thays, Local 17<br />
          Martes a Domingo, 10 a 18 hs
        </p>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-8 border-t border-hueso/10 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs text-hueso/30">
        &copy; {currentYear} Porco Rosso&reg;. Todos los derechos reservados.
      </p>
      <p class="text-xs text-hueso/20">
        Buenos Aires, Argentina
      </p>
    </div>
  </div>
</footer>
