---
import { Image } from "astro:assets";
import logoHueso from "../assets/images/logos/logo-hueso-01.webp";

const currentYear = new Date().getFullYear();

/** Mismo criterio que el NavBar: desde una pagina interna, el ancla suelta no
 *  lleva a ningun lado. Ver el comentario en NavBar.astro. */
const enHome = Astro.url.pathname === "/";
const aSeccion = (id: string) => (enHome ? `#${id}` : `/#${id}`);
---

<footer class="bg-morcilla pt-12 md:pt-16 pb-4">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8 items-start">
      <!-- Logo & tagline -->
      <div class="sm:col-span-2 lg:col-span-1">
        <Image
          src={logoHueso}
          alt="Porco Rosso - Empresa familiar agroindustrial"
          class="h-14 w-auto mb-4"
          widths={[128, 256]}
          sizes="128px"
          loading="lazy"
        />
        <p class="text-hueso/40 text-sm leading-relaxed max-w-xs">
          Empresa familiar agroindustrial.<br />
          Criamos, producimos y disfrutamos.
        </p>
      </div>

      <!-- Secciones -->
      <div>
        <h3 class="font-display font-bold text-xs uppercase tracking-wider text-hueso/60 mb-4">
          Secciones
        </h3>
        <ul class="space-y-2">
          <li><a href="/mayoristas/" class="text-sm text-hueso/40 hover:text-hueso transition-colors">Venta mayorista</a></li>
          <li><a href="/gastronomicos/" class="text-sm text-hueso/40 hover:text-hueso transition-colors">Hoteles y restaurantes</a></li>
          <li><a href={aSeccion("productos")} class="text-sm text-hueso/40 hover:text-hueso transition-colors">Productos</a></li>
          <li><a href={aSeccion("nosotros")} class="text-sm text-hueso/40 hover:text-hueso transition-colors">Nosotros</a></li>
          <li><a href={aSeccion("ventajas")} class="text-sm text-hueso/40 hover:text-hueso transition-colors">Ventajas</a></li>
          <li><a href={aSeccion("preguntas")} class="text-sm text-hueso/40 hover:text-hueso transition-colors">Preguntas frecuentes</a></li>
          <li><a href={aSeccion("contacto")} class="text-sm text-hueso/40 hover:text-hueso transition-colors">Contacto</a></li>
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <h3 class="font-display font-bold text-xs uppercase tracking-wider text-hueso/60 mb-4">
          Contacto
        </h3>
        <ul class="space-y-2">
          <li><a href="tel:+5491172714251" class="text-sm text-hueso/40 hover:text-hueso transition-colors">+54 9 11 7271-4251</a></li>
          <li><a href="mailto:hola@porcorosso.com.ar" class="text-sm text-hueso/40 hover:text-hueso transition-colors">hola@porcorosso.com.ar</a></li>
          <li><a href="https://porcorosso.com.ar" target="_blank" rel="noopener noreferrer" class="text-sm text-hueso/40 hover:text-hueso transition-colors">porcorosso.com.ar</a></li>
          <li><a href="https://www.instagram.com/porcorossoba" target="_blank" rel="noopener noreferrer" class="text-sm text-hueso/40 hover:text-hueso transition-colors">Instagram</a></li>
        </ul>
      </div>

      <!-- Almacen -->
      <div>
        <h4 class="font-display font-bold text-xs uppercase tracking-wider text-hueso/60 mb-4">
          Almacén
        </h4>
        <p class="text-sm text-hueso/40 leading-relaxed">
          Martín Fierro 3361, Ituzaingó<br />
          Complejo Thays, Local 17<br />
          Martes a Domingo, 10 a 18 hs
        </p>
      </div>
    </div>

    <!-- Bottom bar -->
    <div id="footer-bottom" class="mt-12 pt-8 border-t border-hueso/10 flex flex-col items-center gap-3 text-center sm:flex-row sm:justify-between sm:text-left sm:pr-20">
      <p class="text-xs text-hueso/30">
        &copy; {currentYear} Porco Rosso&reg;. Todos los derechos reservados.
      </p>
      <p class="text-xs text-hueso/20">
        <a href="/privacidad/" class="hover:text-hueso/50 transition-colors">Política de privacidad</a>
        <span class="mx-2" aria-hidden="true">&middot;</span>
        Buenos Aires, Argentina
      </p>
    </div>
  </div>

  <!-- Firma separada -->
  <div class="mt-6 flex justify-center sm:justify-start max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <firma-stian enlace="https://stiancode.dev" logo="/firma-stian/logo-claro.png"></firma-stian>
  </div>
</footer>
