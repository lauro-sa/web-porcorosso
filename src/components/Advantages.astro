---
import { Image } from "astro:assets";
import SectionTitle from "./SectionTitle.astro";
import nonaPig from "../assets/images/ilustraciones/nona-pig.webp";

const advantages = [
  {
    number: "01",
    title: "Integración vertical completa",
    text: "Eliminamos a los intermediarios y todos aquellos que no aportan valor a la cadena para lograr mejores precios.",
  },
  {
    number: "02",
    title: "Homogeneidad",
    text: "Hasta donde el animal permita. Producción propia significa mismos estándares alimentarios y sanitarios: cortes parejos, limitados solo por la anatomía del animal.",
  },
  {
    number: "03",
    title: "Flexibilidad productiva",
    text: "Alentamos el desarrollo de productos nuevos. ¿Necesidad de un corte en particular o un grosor específico? Lo podemos desarrollar.",
  },
  {
    number: "04",
    title: "Una operación fluida",
    text: "Automatismos para cuestiones de logística, pedidos y facturación. Personalizada para cuestiones comerciales y operativas.",
  },
];
---

<section id="ventajas" class="py-20 md:py-28 bg-carne">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionTitle
      tag="Ventajas"
      title="Por qué elegir"
      accent="Porco Rosso."
      dark
      description="No somos un frigorífico más. Somos productores con nombre y apellido."
    />

    <div class="grid sm:grid-cols-2 gap-6">
      {advantages.map((adv) => (
        <div class="group p-8 md:p-10 border border-hueso/10 hover:border-hueso/30 transition-colors duration-300">
          <span class="font-display font-bold text-3xl text-hueso/30 group-hover:text-hueso/60 transition-colors">
            {adv.number}
          </span>
          <h3 class="font-display font-bold text-xl md:text-2xl uppercase text-hueso mt-3 mb-2">
            {adv.title}
          </h3>
          <p class="text-sm text-hueso/60 leading-relaxed">
            {adv.text}
          </p>
        </div>
      ))}
    </div>

    <!-- Ilustración decorativa -->
    <div class="mt-12 flex justify-center opacity-40">
      <Image
        src={nonaPig}
        alt="Ilustración Nona Pig - Familia Porco Rosso"
        class="ilustracion-clara h-44 w-auto"
        widths={[240, 480]}
        sizes="240px"
        loading="lazy"
      />
    </div>
  </div>
</section>
