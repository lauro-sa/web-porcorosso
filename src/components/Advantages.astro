---
import SectionTitle from "./SectionTitle.astro";

const advantages = [
  {
    number: "01",
    title: "Precio sin intermediarios",
    text: "Al ser productores directos, eliminamos costos innecesarios de la cadena.",
  },
  {
    number: "02",
    title: "Consistencia garantizada",
    text: "Misma calidad, mismo corte, misma experiencia. Siempre.",
  },
  {
    number: "03",
    title: "Cortes a medida",
    text: "Adaptamos el desposte a las necesidades de tu cocina o negocio.",
  },
  {
    number: "04",
    title: "Volumen asegurado",
    text: "Produccion propia que garantiza stock y continuidad.",
  },
  {
    number: "05",
    title: "Facturacion flexible",
    text: "Nos adaptamos a tu estructura comercial y administrativa.",
  },
  {
    number: "06",
    title: "Un solo proveedor",
    text: "Cerdo, vaca, pollo, embutidos y mas. Todo en un solo lugar.",
  },
];
---

<section id="ventajas" class="py-20 md:py-28 bg-morcilla">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionTitle
      tag="Ventajas"
      title="Por que elegir"
      accent="Porco Rosso."
      dark
      description="No somos un frigorifico mas. Somos productores con nombre y apellido."
    />

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {advantages.map((adv) => (
        <div class="group p-6 md:p-8 border border-hueso/10 hover:border-piel/30 transition-colors duration-300">
          <span class="font-display font-bold text-3xl text-carne/40 group-hover:text-carne transition-colors">
            {adv.number}
          </span>
          <h3 class="font-display font-bold text-lg uppercase text-hueso mt-3 mb-2">
            {adv.title}
          </h3>
          <p class="text-sm text-hueso/50 leading-relaxed">
            {adv.text}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
