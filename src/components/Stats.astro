---
const stats = [
  { value: "16000", suffix: "+", label: "Kg procesados semanalmente" },
  { value: "1600", suffix: "", label: "Madres en criadero propio" },
  { value: "40", suffix: "+", label: "Clientes B2B activos" },
  { value: "100", suffix: "%", label: "Trazabilidad y cadena propia" },
];
---

<section class="bg-carne py-16 md:py-20" aria-label="Cifras clave de Porco Rosso">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="sr-only">Porco Rosso en números</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-4">
      {stats.map((stat) => (
        <div class="text-center">
          <div class="font-display font-bold text-4xl md:text-5xl text-hueso mb-2">
            <span class="stat-number" data-target={stat.value}>0</span>{stat.suffix}
          </div>
          <div class="font-accent text-xs tracking-widest text-hueso/70 uppercase">
            {stat.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Mostrar valores finales inmediatamente para no-JS y evitar flash de "0"
  document.querySelectorAll(".stat-number").forEach((el) => {
    const target = parseInt((el as HTMLElement).dataset.target || "0");
    el.textContent = target.toLocaleString("es-AR");
  });

  // root apunta a #app-scroll: el contador tiene que dispararse cuando la cifra
  // entra en el area que scrollea, no en la ventana entera.
  const scroller = document.getElementById("app-scroll");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        const target = parseInt(el.dataset.target || "0");
        let current = 0;
        el.textContent = "0";
        const step = Math.max(1, Math.floor(target / 40));
        const interval = setInterval(() => {
          current += step;
          if (current >= target) {
            current = target;
            clearInterval(interval);
          }
          el.textContent = current.toLocaleString("es-AR");
        }, 30);
        observer.unobserve(el);
      });
    },
    { threshold: 0.3, root: scroller }
  );
  document.querySelectorAll(".stat-number").forEach((el) => observer.observe(el));
</script>
