---
import { Image } from "astro:assets";
import SectionTitle from "./SectionTitle.astro";
import Button from "./Button.astro";
import papaPig03 from "../assets/images/ilustraciones/papa-pig-03.webp";
import mamaPig from "../assets/images/ilustraciones/mama-pig.webp";

const segments = [
  {
    title: "Mayorista",
    subtitle: "01 — Carnicerías, Distribuidoras & Elaboradores",
    description:
      "Si accedés a nuestros precios mayoristas es porque tenés una unidad de negocio detrás: elaborás tus propios productos y necesitás cortes consistentes, o revendés cortes frescos envasados al vacío y elaborados en tu carnicería. Trabajamos con ese tipo de cliente porque hablamos el mismo idioma y sabemos qué espera de un proveedor.",
    features: [
      "Cortes consistentes para reventa o elaboración propia",
      "Abastecimiento continuo los 365 días",
      "Pedidos y facturación automatizados",
      "Comunicación directa con el equipo comercial",
    ],
    cta: "Ver propuesta mayorista",
    href: "/mayoristas/",
    image: papaPig03,
    alt: "Ilustración Papa Pig - Porco Rosso mayorista",
  },
  {
    title: "Gastronómicos",
    subtitle: "02 — Hoteles, Restaurantes & Catering",
    description:
      "Trabajamos mucho con gastronómicos porque nuestro servicio encaja bárbaro con la enloquecida dinámica de una cocina: producto parejo, sin desperdicio y sabés que salés de la misma dirección. La consistencia es lo que más valoran de nosotros.",
    features: [
      "Desayuno, buffet, carta, banquetes y eventos",
      "Cortes al gramaje que define tu cocina",
      "Entregas puntuales con cadena de frío",
      "Producto parejo que estandariza el costo por plato",
    ],
    cta: "Ver propuesta gastronómica",
    href: "/gastronomicos/",
    image: mamaPig,
    alt: "Ilustración Mama Pig - Porco Rosso gastronómicos",
  },
];
---

<section id="segmentos" class="py-20 md:py-28 bg-hueso">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionTitle
      tag="¿Con quién trabajamos?"
      title="Reconocé"
      accent="tu operación."
      align="center"
      description="Ya tengas una carnicería, una distribuidora, un hotel o un restaurante, tenemos la propuesta justa para tu operación."
    />

    <div class="grid md:grid-cols-2 gap-8 mt-12">
      {segments.map((seg) => (
        <div class="border border-morcilla/10 bg-frigo p-8 md:p-10 flex flex-col">
          <!-- Ilustración -->
          <div class="flex justify-center mb-6">
            <Image
              src={seg.image}
              alt={seg.alt}
              class="h-32 w-auto opacity-70"
              widths={[128, 256]}
              sizes="128px"
              loading="lazy"
            />
          </div>

          <!-- Contenido -->
          <span class="font-accent text-xs tracking-widest text-carne uppercase">
            {seg.subtitle}
          </span>
          <h3 class="font-display font-bold text-3xl md:text-4xl uppercase text-morcilla mt-2 mb-4">
            {seg.title}
          </h3>
          <p class="text-morcilla/60 leading-relaxed mb-6">
            {seg.description}
          </p>

          <!-- Features -->
          <ul class="space-y-3 mb-8 flex-grow">
            {seg.features.map((feat) => (
              <li class="flex items-start gap-3">
                <span class="text-carne font-bold mt-0.5">—</span>
                <span class="text-sm text-morcilla/70">{feat}</span>
              </li>
            ))}
          </ul>

          <!-- CTA: lleva a la pagina del segmento, que responde con el detalle
               y el vocabulario de ese publico. El atajo al formulario queda
               debajo para quien ya se decidio. -->
          <Button href={seg.href} variant="primary" size="lg" class="w-full text-center">
            {seg.cta}
          </Button>
          <a
            href="#contacto"
            class="mt-3 block text-center font-display font-semibold text-xs uppercase tracking-wider text-morcilla/50 hover:text-carne transition-colors"
          >
            O pedí presupuesto ahora
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
