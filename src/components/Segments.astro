---
import SectionTitle from "./SectionTitle.astro";
import Button from "./Button.astro";

const segments = [
  {
    title: "Mayorista",
    subtitle: "01 — Carnicerías, Distribuidoras & Elaboradores",
    description:
      "Si accedés a nuestros precios mayoristas es porque tenés una unidad de negocio detrás: elaborás tus propios productos y necesitás cortes consistentes, o revendés cortes frescos envasados al vacío y elaborados en tu carnicería. Trabajamos con ese tipo de cliente porque hablamos el mismo idioma y sabemos qué espera de un proveedor.",
    features: [
      "Abastecimiento los 365 días del año",
      "Logística ordenada y coordinada",
      "Trazabilidad clara",
      "Comunicación directa",
    ],
    cta: "Soy mayorista",
    image: "/images/ilustraciones/papa-pig-03.png",
    alt: "Ilustración Papa Pig - Porco Rosso mayorista",
  },
  {
    title: "Gastronómicos",
    subtitle: "02 — Restaurantes, Bares & Cocinas",
    description:
      "Trabajamos mucho con gastronómicos porque nuestro servicio encaja bárbaro con la enloquecida dinámica de una cocina: producto parejo, sin desperdicio y sabés que salés de la misma dirección. La consistencia es lo que más valoran de nosotros.",
    features: [
      "Entregas claras y puntuales",
      "Logística ordenada",
      "Pedidos automatizados",
      "Adaptación puntual a tu operación",
    ],
    cta: "Soy gastronómico",
    image: "/images/ilustraciones/papa-pig-03.png",
    alt: "Ilustración Papa Pig - Porco Rosso gastronómicos",
  },
];
---

<section id="segmentos" class="py-20 md:py-28 bg-frigo">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionTitle
      tag="¿Con quién trabajamos?"
      title="Reconocé"
      accent="tu operación."
      align="center"
      description="Ya seas mayorista, consumidor o gastronómico, tenemos la propuesta justa para tu necesidad."
    />

    <div class="grid md:grid-cols-2 gap-8 mt-12">
      {segments.map((seg) => (
        <div class="border border-morcilla/10 bg-hueso p-8 md:p-10 flex flex-col">
          <!-- Ilustración -->
          <div class="flex justify-center mb-6">
            <img
              src={seg.image}
              alt={seg.alt}
              class="h-32 w-auto opacity-70"
              loading="lazy"
            />
          </div>

          <!-- Contenido -->
          <span class="font-accent text-xs tracking-widest text-carne uppercase">
            {seg.subtitle}
          </span>
          <h3 class="font-display font-bold text-3xl md:text-4xl uppercase text-morcilla mt-2 mb-4">
            {seg.title}
          </h3>
          <p class="text-morcilla/60 leading-relaxed mb-6">
            {seg.description}
          </p>

          <!-- Features -->
          <ul class="space-y-3 mb-8 flex-grow">
            {seg.features.map((feat) => (
              <li class="flex items-start gap-3">
                <span class="text-carne font-bold mt-0.5">—</span>
                <span class="text-sm text-morcilla/70">{feat}</span>
              </li>
            ))}
          </ul>

          <!-- CTA -->
          <Button href="#contacto" variant="primary" size="lg" class="w-full text-center">
            {seg.cta}
          </Button>
        </div>
      ))}
    </div>
  </div>
</section>
